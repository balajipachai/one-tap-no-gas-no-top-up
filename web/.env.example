# Copy to .env.local and fill in. Never commit .env.local — it's gitignored.

# From the Privy dashboard (dashboard.privy.io) -> your app -> Settings. This is a
# public, client-side identifier, not a secret.
NEXT_PUBLIC_PRIVY_APP_ID=

# Base Sepolia deployment addresses (see /contracts/README.md for how these were deployed).
NEXT_PUBLIC_CHECKOUT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# Public Base Sepolia RPC endpoint used for reads (balances, order status) from the browser.
# This is a normal read RPC URL, not a keyed bundler/paymaster URL, so it's fine to expose.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
